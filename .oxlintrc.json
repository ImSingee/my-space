{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx_a11y",
    "vitest",
    "import"
  ],
  "jsPlugins": ["./oxlint-plugins/no-dynamic-import.js"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/button-has-type": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-children-prop": "error",
    "react/no-find-dom-node": "error",
    "react/no-string-refs": "error",
    "react/self-closing-comp": "error",
    "react/void-dom-elements-no-children": "error",
    "local/no-dynamic-import": "error",
    "typescript/no-unnecessary-condition": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "rules": {
        "local/no-dynamic-import": "off"
      }
    },
    {
      "files": ["packages/hatch-cli/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/platform-api/views", "**/platform-api/views.*"],
                "message": "Platform views are server output allowlists. Released CLIs must read only the fields they use and pass the rest through."
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".ai",
    ".agents",
    ".claude",
    ".nitro",
    ".output",
    ".tanstack",
    ".turbo",
    "dist",
    "node_modules",
    "src/routeTree.gen.ts",
    "workspace"
  ]
}
