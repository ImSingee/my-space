{
  "name": "my-space",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "tailscale:build": "cd packages/tailscale && go build -trimpath -o ../../bin/hatch-tailscale .",
    "tailscale:test": "cd packages/tailscale && go test ./...",
    "dev": "pnpm hatch-sdk:build && concurrently --kill-others --names platform,runner --prefix-colors blue,magenta \"pnpm dev:platform:watch\" \"pnpm dev:runner:watch\"",
    "dev:platform": "pnpm hatch-sdk:build && pnpm dev:platform:watch",
    "dev:platform:watch": "HATCH_DATA_DIR=../my-space-data vite dev",
    "dev:runner": "pnpm hatch-sdk:build && pnpm dev:runner:watch",
    "dev:runner:watch": "HATCH_DATA_DIR=../my-space-runner-data tsx watch src/runner/main.ts",
    "build": "pnpm hatch-sdk:build && pnpm build:platform && pnpm build:runner && pnpm build:cli",
    "build:platform": "vite build",
    "build:runner": "tsx scripts/build-runner.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "cli": "tsx packages/hatch-cli/src/main.ts",
    "preview": "HATCH_DATA_DIR=../my-space-data node dist/platform/server/index.mjs",
    "test": "pnpm hatch-sdk:build && vitest run",
    "test:unit": "pnpm hatch-sdk:build && vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint": "oxlint .",
    "format": "oxfmt --write . && oxlint . --fix && oxfmt --write . && oxlint .",
    "check:types": "tsc --noEmit && pnpm hatch-sdk:check",
    "hatch-sdk:build": "tsx scripts/build-hatch-sdk.ts",
    "hatch-sdk:check": "tsc -p sdk-internal/tsconfig.json --noEmit",
    "migrations:generate": "drizzle-kit generate",
    "migrations:apply": "drizzle-kit migrate",
    "migrations:push": "drizzle-kit push",
    "auth:generate": "pnpx auth@1.7.7 generate --config ./src/auth/server.ts --output ./src/db/auth-schema.ts -y && pnpm format",
    "db:seed": "tsx scripts/seed-db.ts",
    "drizzle:studio": "drizzle-kit studio",
    "platform-api:generate": "tsx scripts/generate-platform-api.ts",
    "platform-api:check": "tsx scripts/generate-platform-api.ts --check"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@connectrpc/validate": "^0.2.0",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@floating-ui/dom": "^1.8.0",
    "@lobehub/icons": "^5.23.0",
    "@mantine/carousel": "^9.7.1",
    "@mantine/charts": "^9.7.1",
    "@mantine/code-highlight": "^9.7.1",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/dropzone": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/modals": "^9.7.1",
    "@mantine/nprogress": "^9.7.1",
    "@mantine/spotlight": "^9.7.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/router-plugin": "^1.168.42",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "better-auth": "1.7.7",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "jose": "^6.2.10",
    "katex": "^0.19.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "4.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "lefthook": "^2.2.1",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pkg-pr-new": "0.0.91",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "web-vitals": "^6.2.3"
  }
}
