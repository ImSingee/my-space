{
  "name": "my-space",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm hatch-sdk:build && concurrently --kill-others --names platform,runner --prefix-colors blue,magenta \"pnpm dev:platform:watch\" \"pnpm dev:runner:watch\"",
    "dev:platform": "pnpm hatch-sdk:build && pnpm dev:platform:watch",
    "dev:platform:watch": "HATCH_DATA_DIR=../my-space-data vite dev --port 3700",
    "dev:runner": "pnpm hatch-sdk:build && pnpm dev:runner:watch",
    "dev:runner:watch": "HATCH_DATA_DIR=../my-space-runner-data tsx watch src/runner/main.ts",
    "build": "pnpm hatch-sdk:build && pnpm build:platform && pnpm build:runner",
    "build:platform": "vite build",
    "build:runner": "tsx scripts/build-runner.ts",
    "preview": "HATCH_DATA_DIR=../my-space-data node dist/platform/server/index.mjs",
    "test": "pnpm hatch-sdk:build && vitest run",
    "test:unit": "pnpm hatch-sdk:build && vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint": "oxlint .",
    "format": "oxfmt --write . && oxlint . --fix && oxfmt --write . && oxlint .",
    "check:types": "tsc --noEmit && pnpm hatch-sdk:check",
    "hatch-sdk:build": "tsc -p packages/hatch-data/tsconfig.json",
    "hatch-sdk:check": "tsc -p packages/hatch-data/tsconfig.json --noEmit",
    "migrations:generate": "drizzle-kit generate",
    "migrations:apply": "drizzle-kit migrate",
    "migrations:push": "drizzle-kit push",
    "auth:generate": "pnpx auth@1.7.2 generate --config ./src/auth/server.ts --output ./src/db/auth-schema.ts -y && pnpm format",
    "db:seed": "tsx scripts/seed-db.ts",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@earendil-works/pi-agent-core": "^0.80.2",
    "@earendil-works/pi-ai": "^0.80.2",
    "@floating-ui/dom": "^1.8.0",
    "@lobehub/icons": "^5.16.0",
    "@mantine/carousel": "^9.5.2",
    "@mantine/charts": "^9.5.2",
    "@mantine/code-highlight": "^9.5.2",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/dropzone": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/modals": "^9.5.2",
    "@mantine/nprogress": "^9.5.2",
    "@mantine/spotlight": "^9.5.2",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/router-plugin": "^1.168.35",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "better-auth": "1.7.2",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "katex": "^0.18.4",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^1.5.2",
    "react-markdown": "^10.1.0",
    "react-resizable": "4.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "ulid": "^3.0.2",
    "ws": "^8.21.3",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-grid-layout": "^1.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "lefthook": "^2.1.12",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0",
    "web-vitals": "^6.2.1"
  }
}
